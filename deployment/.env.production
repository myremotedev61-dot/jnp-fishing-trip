# =====================================================================
# KONFIGURASI PRODUCTION ENVIRONMENT - FISHING TRIP
# =====================================================================

CI_ENVIRONMENT = production

# --------------------------------------------------------------------
# APP
# --------------------------------------------------------------------
app.baseURL = 'https://fishingtrip.yourdomain.com/'
app.forceGlobalSecureRequests = true
app.sessionDriver = 'CodeIgniter\Session\Handlers\FileHandler'
app.sessionCookieName = 'ft_session'
app.sessionExpiration = 7200
app.sessionSavePath = WRITEPATH . 'session'
app.sessionMatchIP = false
app.sessionTimeToUpdate = 300
app.sessionRegenerateDestroy = false
app.appTimezone = 'Asia/Makassar'

# --------------------------------------------------------------------
# DATABASE (MySQL / MariaDB Production)
# --------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = fishing_trip_prod
database.default.username = fishing_user
database.default.password = YourStrongDatabasePassword2026!
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# --------------------------------------------------------------------
# SECURITY & ENCRYPTION
# --------------------------------------------------------------------
encryption.key = hex2bin:b1d5c219602e1c944883f84f00192e4ab7890123456789abcdef0123456789ab

# --------------------------------------------------------------------
# FIREBASE CLOUD MESSAGING (Opsional untuk Push Notification)
# --------------------------------------------------------------------
FCM_SERVER_KEY = YourFirebaseServerKeyHere
